# Copy this to .env and fill in real values. .env itself is gitignored —
# it holds this NAS's actual folder layout and domain, which don't belong
# in a public repo.

# Absolute path to the actual Obsidian vault (the folder containing
# .obsidian/), not just any parent folder it happens to live in — the
# stager walks this path on every change, so scoping it precisely also
# keeps reconciles fast.
VAULT_DIR=/path/to/your/obsidian/vault

# Bare domain published notes are served at (no scheme). Point a reverse
# proxy at this domain -> <nas-ip>:8098, TLS terminated there.
PUBLIC_DOMAIN=notes.example.com
